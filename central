    const data = {name, role: document.getElementById('f_role').value.trim(), division: document.getElementById('f_division').value, phone: document.getElementById('f_phone').value.trim()};
    if(editing){ await Store.update('mg_freelancers', id, data); } else { await Store.add('mg_freelancers', data); }
    await refreshAll(); closeModal(); render(); toast(editing?'Saved':'Added');
  };
}
