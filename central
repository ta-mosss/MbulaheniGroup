    </div>
    <div class="table-wrap">
      <div class="table-toolbar">
        <select id="crmDivFilter"><option value="all">All divisions</option>${state.divisions.map(d=>`<option value="${d.id}">${esc(d.name)}</option>`).join('')}</select>
        <select id="crmStatFilter"><option value="all">All statuses</option>${[...new Set(state.crm.map(r=>r.status).filter(Boolean))].map(s=>`<option value="${esc(s)}">${esc(s)}</option>`).join('')}</select>
