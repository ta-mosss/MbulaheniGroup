/* =========================================================================
   UNIFIED CALENDAR (NEW)
========================================================================= */
function renderCalendar(v, ta){
  ta.innerHTML = `<button class="btn ghost sm" id="calToday">Today</button>`;
  document.getElementById('calToday').onclick = ()=>{
    state.calMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
    renderCalendar();
  };

  v.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <div style="display:flex;gap:10px;align-items:center;">
        <button class="btn sm ghost" id="calPrev">‹</button>
        <span style="font-weight:700;font-size:18px;" id="calMonthLabel"></span>
        <button class="btn sm ghost" id="calNext">›</button>
      </div>
      <span style="color:var(--text-faint);font-size:12px;">Tasks · Follow-ups · Cleaning · SLA</span>
    </div>
    <div class="card">
      <div class="cal-grid" id="calGrid"></div>
    </div>
    <div id="calSelectedTasks" style="margin-top:16px;"></div>
  `;

  const renderCal = () => {
    const m = state.calMonth;
    document.getElementById('calMonthLabel').textContent = m.toLocaleDateString('en-ZA', {month:'long', year:'numeric'});
    const first = new Date(m.getFullYear(), m.getMonth(), 1);
    const startOffset = first.getDay();
    const daysInMonth = new Date(m.getFullYear(), m.getMonth()+1, 0).getDate();
    const grid = document.getElementById('calGrid');
    grid.innerHTML = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(d=>`<div class="cal-dow">${d}</div>`).join('');
    const todayStr = todayISO();
    const totalCells = Math.ceil((startOffset+daysInMonth)/7)*7;

    // Gather events: tasks + CRM follow-ups + cleaning jobs + SLA deadlines
    const allEvents = [];
    state.tasks.forEach(t => {
      if(t.dueDate) allEvents.push({ date: t.dueDate, label: t.title, type: 'task', status: t.status });
    });
    state.crm.forEach(c => {
      if(c.followUpDate) allEvents.push({ date: c.followUpDate, label: `📞 ${c.client}`, type: 'followup' });
    });
    // Add cleaning jobs
    state.stats._rawCleanTickets = state.stats._rawCleanTickets || [];
    state.stats._rawCleanTickets.forEach(t => {
      if(t.scheduledDate) allEvents.push({ date: t.scheduledDate, label: `🧹 ${t.clientName}`, type: 'cleaning' });
    });
    // SLA deadlines: tickets with open status
    state.stats._rawITTickets = state.stats._rawITTickets || [];
    state.stats._rawITTickets.forEach(t => {
      if(t.status !== 'closed' && t.status !== 'resolved') {
        const d = getDateValue(t.createdAt);
        if(d) {
          const hours = { Urgent:4, High:8, Medium:24, Low:48 }[t.priority] || 24;
          const deadline = new Date(d.getTime() + hours * 3600 * 1000);
          const dateStr = deadline.toISOString().slice(0,10);
          allEvents.push({ date: dateStr, label: `⏱️ ${t.ref} SLA`, type: 'sla' });
        }
      }
    });

    for(let i=0;i<totalCells;i++){
      const dayNum = i - startOffset + 1;
      const inMonth = dayNum>=1 && dayNum<=daysInMonth;
      const dateStr = inMonth ? `${m.getFullYear()}-${String(m.getMonth()+1).padStart(2,'0')}-${String(dayNum).padStart(2,'0')}` : null;
      const dayEvents = inMonth ? allEvents.filter(e=>e.date===dateStr) : [];
      const cell = el(`<div class="cal-cell ${!inMonth?'faded':''} ${dateStr===todayStr?'today':''}">
          <div class="d">${inMonth?dayNum:''}</div>
          <div class="items">
            ${dayEvents.slice(0,3).map(e => `<div class="cal-chip" style="${e.type==='sla'?'color:var(--red)':e.type==='cleaning'?'color:var(--amber)':''}">${esc(e.label)}</div>`).join('')}
            ${dayEvents.length>3?`<div class="cal-more">+${dayEvents.length-3} more</div>`:''}
          </div>
        </div>`);
      if(inMonth) cell.onclick = ()=>{
        document.getElementById('calSelectedTasks').innerHTML = `
          <div class="card">
            <div class="cell-main" style="margin-bottom:8px">${fmtDate(dateStr)}</div>
            ${dayEvents.length ? dayEvents.map(e=>`<div style="padding:6px 0;border-bottom:1px solid var(--border-soft);font-size:12px;">${esc(e.label)}</div>`).join('') : '<div class="cell-sub">Nothing scheduled.</div>'}
          </div>`;
      };
      grid.appendChild(cell);
    }
  };

  document.getElementById('calPrev').onclick = ()=>{
    state.calMonth = new Date(state.calMonth.getFullYear(), state.calMonth.getMonth()-1, 1);
    renderCal();
  };
  document.getElementById('calNext').onclick = ()=>{
    state.calMonth = new Date(state.calMonth.getFullYear(), state.calMonth.getMonth()+1, 1);
    renderCal();
  };
  renderCal();
}

