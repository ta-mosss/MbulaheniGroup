// ─── STORE (Firestore + local fallback) ───────────────────────────
function localGet(coll){ try{ return JSON.parse(localStorage.getItem(LS_PREFIX+coll) || '[]'); }catch(e){ return []; } }
function localSet(coll, arr){ localStorage.setItem(LS_PREFIX+coll, JSON.stringify(arr)); }

const Store = {
  async list(coll){
    if(state.firebaseReady && state.db){
      try{
        const snap = await state.db.collection(coll).get();
        return snap.docs.map(d=>({id:d.id, ...d.data()}));
      }catch(e){ console.warn('Firestore list fallback', e); return localGet(coll); }
    }
    return localGet(coll);
  },
  async add(coll, data){
    data._createdAt = Date.now();
    if(state.firebaseReady && state.db && state.user){
      data._owner = state.user.uid;
      data._ownerEmail = state.user.email;
      const ref = await state.db.collection(coll).add(data);
      return ref.id;
    } else {
      const arr = localGet(coll);
      const id = 'local_'+Date.now().toString(36)+Math.random().toString(36).slice(2,7);
      arr.unshift({id, ...data});
      localSet(coll, arr);
      return id;
    }
  },
  async update(coll, id, data){
    data._updatedAt = Date.now();
    if(state.firebaseReady && state.db && state.user){
      await state.db.collection(coll).doc(id).update(data);
      return;
    } else {
      const arr = localGet(coll);
      const idx = arr.findIndex(x=>x.id===id);
      if(idx>-1){ arr[idx]={...arr[idx], ...data}; localSet(coll, arr); }
    }
  },
  async set(coll, id, data){
    if(state.firebaseReady && state.db && state.user){
      await state.db.collection(coll).doc(id).set(data, {merge:true});
      return;
    } else {
      const arr = localGet(coll);
      const idx = arr.findIndex(x=>x.id===id);
      if(idx>-1){ arr[idx]={...arr[idx], ...data}; } else { arr.push({id, ...data}); }
      localSet(coll, arr);
    }
  },
  async remove(coll, id){
    if(state.firebaseReady && state.db && state.user){
      await state.db.collection(coll).doc(id).delete();
      return;
    } else {
      localSet(coll, localGet(coll).filter(x=>x.id!==id));
    }
  }
};

// ─── FIX: Atomic counter for CRM refs (Firestore transaction) ────
async function getNextRef(divisionId, typeId){
  if(!state.db) return 'ERR-000';
  const docRef = state.db.collection('mg_meta').doc('counters');
  try {
    const result = await state.db.runTransaction(async (transaction) => {
      const doc = await transaction.get(docRef);
      const data = doc.exists ? doc.data() : {};
      const key = `${divisionId}_${typeId}`;
      const next = (data[key] || 0) + 1;
      transaction.set(docRef, { [key]: next }, { merge: true });
      const prefix = (divisionById(divisionId).short || 'MG').toUpperCase();
      const typeLetter = { enquiry:'E', quotation:'Q', invoice:'I', complaint:'C', rating:'R' }[typeId] || 'X';
      const year = new Date().getFullYear();
      return `${prefix}-${typeLetter}-${year}-${String(next).padStart(3, '0')}`;
    });
    return result;
  } catch(e) {
    console.error('Counter transaction failed:', e);
    // fallback to non-atomic (but better than crashing)
    const prefix = (divisionById(divisionId).short || 'MG').toUpperCase();
    const typeLetter = { enquiry:'E', quotation:'Q', invoice:'I', complaint:'C', rating:'R' }[typeId] || 'X';
    const year = new Date().getFullYear();
    const count = state.crm.filter(r=>r.division===divisionId && r.type===typeId).length + 1;
    return `${prefix}-${typeLetter}-${year}-${String(count).padStart(3, '0')}`;
  }
}

// ─── COMPUTE LIVE STATS (with bug fixes) ──────────────────────────
async function computeLiveStats(){
  if(!state.firebaseReady || !state.db) return;

  // --- IT (tickets) ---
  try {
    const itSnap = await state.db.collection('tickets').get();
    const itTickets = itSnap.docs.map(d => d.data());
    const open = itTickets.filter(t => t.status !== 'closed' && t.status !== 'resolved').length;
    const critical = itTickets.filter(t => t.priority === 'Urgent' && t.status !== 'closed').length;
    const now = Date.now();
    let slaBreach = 0;
    itTickets.forEach(t => {
      if (t.status === 'closed' || t.status === 'resolved') return;
      const createdDate = getDateValue(t.createdAt);
      if (!createdDate) return;
      const created = createdDate.getTime();
      const hours = { Urgent:4, High:8, Medium:24, Low:48 }[t.priority] || 24;
      if ((now - created) > hours * 3600 * 1000) slaBreach++;
    });
    state.stats.citm = { openTickets: open, critical, slaBreaches: slaBreach };
  } catch(e) { console.warn('IT stats failed', e); }

  // --- Cleaning (mgfc_tickets) ───
  // FIXED: explicit parentheses around priority check
  try {
    const cleanSnap = await state.db.collection('mgfc_tickets').get();
    const cleanTickets = cleanSnap.docs.map(d => d.data());
    const today = todayISO();
    const jobsToday = cleanTickets.filter(t => t.scheduledDate === today || t.requestedDate === today).length;
    const sitesActive = new Set(cleanTickets.filter(t => t.status !== 'cancelled' && t.status !== 'closed').map(t => t.address)).size;
    const staffDeployed = new Set(cleanTickets.filter(t => t.status === 'scheduled' || t.status === 'in-progress').map(t => t.assignedTeam)).size;
    // FIXED: properly parenthesized
    const openIssues = cleanTickets.filter(t =>
      t.status !== 'closed' &&
      t.status !== 'cancelled' &&
      (t.priority === 'High' || t.priority === 'Urgent')
    ).length;
    state.stats.mgfc = { jobsToday, sitesActive, staffDeployed, openIssues };
  } catch(e) { console.warn('Cleaning stats failed', e); }
}

