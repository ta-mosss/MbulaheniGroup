      <h3>🔐 Authentication</h3>
      <div class="desc">Sign in with an admin email (${ADMIN_EMAILS.join(', ')}) to get full write access. Firebase config is hardcoded for production security.</div>
      ${state.user ? `
        <div class="auth-status">
          <span class="pill ${state.isAdmin?'admin':''}">✅ Signed in as ${esc(state.user.email)} ${state.isAdmin?'(Admin)':''}</span>
          <button class="btn danger sm" id="logoutBtn">Sign out</button>
        </div>
      ` : `
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;">
          <div class="field" style="max-width:220px;margin:0;"><label>Email</label><input id="loginEmail" placeholder="admin@..."></div>
          <div class="field" style="max-width:180px;margin:0;"><label>Password</label><input id="loginPass" type="password" placeholder="••••••••"></div>
          <button class="btn primary" id="loginBtn">Sign in</button>
        </div>
      `}
    </div>

    <div class="settings-block">
      <h3>📡 System Status</h3>
      <div class="desc">${state.firebaseReady ? '✅ Connected to Firestore (production)' : '⚠️ Not connected to Firestore'}</div>
      <div style="background:var(--bg);padding:10px 14px;border-radius:8px;font-family:var(--font-mono);font-size:11px;color:var(--text-dim);word-break:break-all;">
        Project: test-bot-49f99<br>
        Auth: ${state.user ? state.user.email : 'Not signed in'}
      </div>
    </div>

    <div class="settings-block"><h3>💾 Data</h3><div class="desc">Export all data or reset local demo storage.</div><button class="btn sm" id="exportBtn">Export JSON</button> <button class="btn sm danger" id="resetBtn">Clear local data</button></div>

    <div class="settings-block"><h3>🔒 Security Note</h3><div class="desc">The UI admin check (hiding Delete buttons) is a convenience. Firestore Security Rules (with <code class="inline">isAdmin()</code> checking email) are the real gate. Never rely on client-side checks alone.</div></div>
  `;
  if(!state.user){ document.getElementById('loginBtn').onclick = ()=>{ const e=document.getElementById('loginEmail').value; const p=document.getElementById('loginPass').value; if(e&&p) signIn(e,p); else toast('Enter email and password'); }; }
  if(state.user){ document.getElementById('logoutBtn').onclick = signOut; }

  document.getElementById('exportBtn').onclick = ()=>{
    const payload={divisions:state.divisions, crm:state.crm, freelancers:state.freelancers, activity:state.activity, tasks:state.tasks, employees:state.employees, stats:state.stats, exportedAt:new Date().toISOString()};
    const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});
    const a=document.createElement('a');
    a.href=URL.createObjectURL(blob);
    a.download=`mgcentral-export-${todayISO()}.json`;
    a.click();
  };
  document.getElementById('resetBtn').onclick = async ()=>{
    if(!confirm('Clear all local demo data?')) return;
    ['mg_divisions','mg_crm','mg_freelancers','mg_activity','mg_tasks','mg_stats','mg_employees'].forEach(c=>localStorage.removeItem(LS_PREFIX+c));
    await refreshAll(); render(); toast('Cleared');
  };
}

