        <td>${esc(a.actType||'—')}</td>
        <td>${esc(a.client||'—')}</td>
        <td style="max-width:260px;color:var(--text-dim)">${esc(a.notes||'')}</td>
        <td><span class="badge b-neutral">${esc(a.status||'Logged')}</span></td>
        <td>${state.isAdmin?`<button class="icon-btn" data-act-del="${a.id}" title="Delete">🗑</button>`:''}</td>
      </tr>`;
    }).join('') : `<tr><td colspan="7" class="table-empty">No activity for this filter.</td></tr>`;
    document.querySelectorAll('[data-act-del]').forEach(b=>b.onclick=async()=>{if(!confirm('Delete?'))return; await Store.remove('mg_activity',b.dataset.actDel); await refreshAll(); render(); toast('Deleted');});
  };
  document.getElementById('actFlFilter').onchange = renderActRows;
  document.getElementById('actDateFilter').onchange = renderActRows;
  renderActRows();
}
function openFreelancerModal(id){
  if(!state.user){ toast('Sign in'); return; }
  const editing = !!id;
  const f = editing ? state.freelancers.find(x=>x.id===id) : {name:'', role:'', division:state.divisions[0]?.id, phone:''};
  openModal(`
    <h3>${editing?'Edit Freelancer':'Add Freelancer'}</h3>
    <div class="field"><label>Name</label><input id="f_name" value="${esc(f.name)}"></div>
    <div class="field-row">
      <div class="field"><label>Role</label><input id="f_role" value="${esc(f.role)}"></div>
      <div class="field"><label>Division</label><select id="f_division">${state.divisions.map(d=>`<option value="${d.id}" ${f.division===d.id?'selected':''}>${esc(d.name)}</option>`).join('')}</select></div>
    </div>
    <div class="field"><label>Phone</label><input id="f_phone" value="${esc(f.phone)}"></div>
    <div class="modal-actions">
      ${editing?`<button class="btn danger ghost" id="delFlBtn" style="margin-right:auto">Remove</button>`:''}
      <button class="btn ghost" onclick="closeModal()">Cancel</button>
      <button class="btn primary" id="saveFlBtn">${editing?'Save':'Add'}</button>
    </div>
  `);
  if(editing) document.getElementById('delFlBtn').onclick = async ()=>{
    if(!confirm('Remove this freelancer?')) return;
    await Store.remove('mg_freelancers', id); await refreshAll(); closeModal(); render(); toast('Removed');
  };
  document.getElementById('saveFlBtn').onclick = async ()=>{
    const name = document.getElementById('f_name').value.trim();
