    </div>
  `;
  document.querySelectorAll('#crmTypeTabs .tab-btn').forEach(b=> b.onclick = ()=>{ state.crmFilter=b.dataset.type; render(); });
  document.getElementById('crmDivFilter').onchange = (e)=>{ const val=e.target.value; let r2=state.crm.slice(); if(state.crmFilter!=='all') r2=r2.filter(r=>r.type===state.crmFilter); if(val!=='all') r2=r2.filter(r=>r.division===val); document.getElementById('crmRows').innerHTML = r2.length? r2.map(rowHtmlCrm).join('') : `<tr><td colspan="8" class="table-empty">No records.</td></tr>`; bindCrmRowEvents(); };
  document.getElementById('crmStatFilter').onchange = (e)=>{ state.crmStatusFilter=e.target.value; render(); };
  bindCrmRowEvents();
}
function rowHtmlCrm(r){
  const d = divisionById(r.division);
  let detail = '';
  if(r.type==='quotation'||r.type==='invoice') detail = r.amount ? `R ${Number(r.amount).toLocaleString()}` : '—';
  else if(r.type==='complaint') detail = `<span class="${sevClass(r.severity)}">${esc(r.severity||'—')}</span>`;
  else if(r.type==='rating') detail = `<span class="stars">${'★'.repeat(Number(r.rating||0))}${'☆'.repeat(5-Number(r.rating||0))}</span>`;
  else detail = esc(r.description ? (r.description.slice(0,40)+(r.description.length>40?'…':'')) : '—');
  const isOwner = state.user && r._owner === state.user.uid;
  const canEdit = state.user && (isOwner || state.isAdmin);
  return `<tr data-id="${r.id}">
    <td>${crmTypeMeta(r.type).label}</td>
    <td><div class="cell-main">${esc(r.client||'—')}</div><div class="cell-sub">${esc(r.contact||'')}</div></td>
    <td><span class="dtag" style="--dc:${d.color}"><span class="dot"></span>${esc(d.short)}</span></td>
    <td style="font-family:var(--font-mono);font-size:11.5px;color:var(--text-dim)">${esc(r.ref||'—')}</td>
    <td><span class="badge ${statusBadgeClass(r.status)}">${esc(r.status||'—')}</span></td>
    <td style="max-width:220px">${detail}</td>
    <td style="white-space:nowrap;color:var(--text-faint);font-size:12px">${fmtDate(r._createdAt)}</td>
    <td>${canEdit ? `<div class="row-actions"><button class="icon-btn" data-crm-edit="${r.id}" title="Edit">✎</button>${state.isAdmin? `<button class="icon-btn" data-crm-del="${r.id}" title="Delete">🗑</button>`:''}</div>` : `<span style="font-size:10px;color:var(--text-faint);">🔒</span>`}</td>
  </tr>`;
}
function bindCrmRowEvents(){
  document.querySelectorAll('[data-crm-edit]').forEach(b=> b.onclick = ()=> openCrmModal(b.dataset.crmEdit));
  document.querySelectorAll('[data-crm-del]').forEach(b=> b.onclick = async ()=>{ if(!confirm('Delete?')) return; await Store.remove('mg_crm', b.dataset.crmDel); await refreshAll(); render(); toast('Deleted'); });
}
function openCrmModal(recId){
  if(!state.user){ toast('Sign in to create records'); return; }
  const editing=!!recId; const r=editing?state.crm.find(x=>x.id===recId):{type:'enquiry',division:state.divisions[0]?.id,status:'New',client:'',contact:'',description:'',amount:'',severity:'Medium',rating:'5',ref:''};
  openModal(`<h3>${editing?'Edit':'New'} record</h3><div class="modal-sub">All records stored in mg_crm with your UID as _owner.</div>
    <div class="field-row"><div class="field"><label>Type</label><select id="f_type">${CRM_TYPES.map(t=>`<option value="${t.id}" ${r.type===t.id?'selected':''}>${t.label}</option>`).join('')}</select></div>
    <div class="field"><label>Division</label><select id="f_division">${state.divisions.map(d=>`<option value="${d.id}" ${r.division===d.id?'selected':''}>${esc(d.name)}</option>`).join('')}</select></div></div>
    <div class="field-row"><div class="field"><label>Client</label><input id="f_client" value="${esc(r.client)}"></div><div class="field"><label>Contact</label><input id="f_contact" value="${esc(r.contact)}"></div></div>
    <div class="field"><label>Description</label><textarea id="f_description">${esc(r.description)}</textarea></div>
    <div class="field-row"><div class="field"><label>Status</label><select id="f_status"></select></div><div class="field" id="amountField"><label>Amount (R)</label><input id="f_amount" type="number" value="${r.amount||''}"></div></div>
    <div class="field-row"><div class="field" id="severityField"><label>Severity</label><select id="f_severity">${SEVERITIES.map(s=>`<option ${r.severity===s?'selected':''}>${s}</option>`).join('')}</select></div>
    <div class="field" id="ratingField"><label>Rating</label><select id="f_rating">${[5,4,3,2,1].map(n=>`<option value="${n}" ${String(r.rating)===String(n)?'selected':''}>${n}</option>`).join('')}</select></div></div>
    <div class="field"><label>Reference</label><input id="f_ref" value="${esc(r.ref)}"></div>
    <div class="modal-actions">${editing?`<button class="btn danger ghost" id="delCrmBtn" style="margin-right:auto">Delete</button>`:''}<button class="btn ghost" onclick="closeModal()">Cancel</button><button class="btn primary" id="saveCrmBtn">${editing?'Save':'Create'}</button></div>`);
  const refreshStatus=()=>{ const type=document.getElementById('f_type').value; const meta=crmTypeMeta(type); document.getElementById('f_status').innerHTML=meta.statuses.map(s=>`<option ${r.status===s?'selected':''}>${s}</option>`).join(''); document.getElementById('amountField').style.display=(type==='quotation'||type==='invoice')?'':'none'; document.getElementById('severityField').style.display=type==='complaint'?'':'none'; document.getElementById('ratingField').style.display=type==='rating'?'':'none'; };
  document.getElementById('f_type').onchange=refreshStatus; refreshStatus();
  if(editing) document.getElementById('delCrmBtn').onclick = async ()=>{ if(!confirm('Delete?')) return; await Store.remove('mg_crm', recId); await refreshAll(); closeModal(); render(); toast('Deleted'); };
  document.getElementById('saveCrmBtn').onclick = async ()=>{
    const type=document.getElementById('f_type').value;
    const division=document.getElementById('f_division').value;
    const client=document.getElementById('f_client').value.trim();
    if(!client){ toast('Client required'); return; }
    // Generate ref atomically via transaction
    let ref = document.getElementById('f_ref').value.trim();
    if(!ref) ref = await getNextRef(division, type);
    const data={
      type, division, client,
      contact: document.getElementById('f_contact').value.trim(),
      description: document.getElementById('f_description').value.trim(),
      status: document.getElementById('f_status').value,
      amount: document.getElementById('f_amount').value || null,
      severity: document.getElementById('f_severity').value,
      rating: document.getElementById('f_rating').value,
      ref,
      _updatedAt: Date.now()
    };
    if(editing){ await Store.update('mg_crm', recId, data); } else { await Store.add('mg_crm', data); }
    await refreshAll(); closeModal(); render(); toast(editing?'Updated':'Created');
  };
}

