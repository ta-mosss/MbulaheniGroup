<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mbulaheni Group — Central OS</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<style>
/* ============ TOKENS ============ */
:root{
  --obsidian:#0a0e14;
  --panel:#111826;
  --panel-2:#141d2c;
  --elevated:#182337;
  --border:#212e42;
  --border-soft:#1a2436;
  --text:#e7ecf3;
  --text-dim:#8c98ac;
  --text-faint:#5c6b83;
  --teal:#2dd4bf;
  --teal-dim:#1b8f80;
  --amber:#f2a541;
  --violet:#a78bfa;
  --blue:#5eaaff;
  --rose:#fb7c8d;
  --red:#ef5a6f;
  --green:#4ade80;
  --radius:10px;
  --radius-lg:16px;
  --font-display:'Plus Jakarta Sans',sans-serif;
  --font-mono:'IBM Plex Mono',monospace;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:
    radial-gradient(1200px 600px at 85% -10%, rgba(45,212,191,0.06), transparent 60%),
    radial-gradient(900px 500px at -5% 100%, rgba(167,139,250,0.05), transparent 60%),
    var(--obsidian);
  color:var(--text);
  font-family:var(--font-display);
  min-height:100vh;
  -webkit-font-smoothing:antialiased;
}
::selection{background:rgba(45,212,191,0.25);}
::-webkit-scrollbar{width:10px;height:10px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:8px;}
a{color:inherit;}
button{font-family:inherit;}
:focus-visible{outline:2px solid var(--teal);outline-offset:2px;}

/* ============ LAYOUT ============ */
.app{display:grid;grid-template-columns:248px 1fr;min-height:100vh;}
@media(max-width:900px){.app{grid-template-columns:1fr;}}

/* ---- Sidebar ---- */
.sidebar{
  background:linear-gradient(180deg, var(--panel), var(--obsidian));
  border-right:1px solid var(--border-soft);
  padding:22px 16px;
  position:sticky;top:0;height:100vh;
  display:flex;flex-direction:column;
  z-index:20;
}
@media(max-width:900px){
  .sidebar{position:fixed;left:0;top:0;width:248px;transform:translateX(-100%);transition:transform .25s ease;box-shadow:20px 0 40px rgba(0,0,0,.5);}
  .sidebar.open{transform:translateX(0);}
}
.brand{display:flex;align-items:center;gap:10px;padding:2px 6px 22px;}
.brand-mark{
  width:34px;height:34px;border-radius:9px;
  background:conic-gradient(from 220deg, var(--teal), var(--blue) 40%, var(--violet) 75%, var(--teal));
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-mono);font-weight:600;font-size:13px;color:var(--obsidian);
  flex:none;
}
.brand-text{line-height:1.15;}
.brand-text .g{font-weight:800;font-size:14.5px;letter-spacing:.2px;}
.brand-text .s{font-family:var(--font-mono);font-size:10.5px;color:var(--text-dim);letter-spacing:.14em;text-transform:uppercase;}

.nav{display:flex;flex-direction:column;gap:2px;margin-top:6px;}
.nav-label{font-family:var(--font-mono);font-size:10px;letter-spacing:.16em;color:var(--text-faint);text-transform:uppercase;margin:16px 10px 6px;}
.nav-item{
  display:flex;align-items:center;gap:11px;
  padding:9px 11px;border-radius:9px;
  color:var(--text-dim);font-size:13.5px;font-weight:600;
  cursor:pointer;border:1px solid transparent;
  transition:background .15s, color .15s, border-color .15s;
  white-space:nowrap;
}
.nav-item svg{flex:none;width:16px;height:16px;opacity:.85;}
.nav-item:hover{background:var(--elevated);color:var(--text);}
.nav-item.active{background:rgba(45,212,191,0.09);color:var(--teal);border-color:rgba(45,212,191,0.22);}
.nav-item.active svg{opacity:1;}
.nav-badge{
  margin-left:auto;font-family:var(--font-mono);font-size:10px;
  background:var(--elevated);color:var(--text-dim);border-radius:6px;padding:1px 6px;
}
.nav-item.active .nav-badge{background:rgba(45,212,191,0.18);color:var(--teal);}

.sidebar-foot{margin-top:auto;padding-top:14px;border-top:1px solid var(--border-soft);}
.mode-pill{
  display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:10.5px;
  padding:8px 10px;border-radius:8px;background:var(--panel-2);border:1px solid var(--border-soft);color:var(--text-dim);
}
.mode-dot{width:7px;height:7px;border-radius:50%;background:var(--amber);flex:none;}
.mode-dot.live{background:var(--green);box-shadow:0 0 8px rgba(74,222,128,.6);}
.whoami{margin-top:10px;font-size:11px;color:var(--text-faint);padding:0 2px;}
.whoami b{color:var(--text-dim);}

/* ---- Main ---- */
.main{padding:26px 34px 60px;max-width:1400px;width:100%;}
@media(max-width:640px){.main{padding:18px 16px 50px;}}
.topbar{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:26px;flex-wrap:wrap;}
.topbar h1{font-size:22px;margin:0 0 4px;letter-spacing:-.01em;}
.topbar .sub{color:var(--text-dim);font-size:13px;max-width:60ch;}
.menu-toggle{display:none;background:var(--panel);border:1px solid var(--border);color:var(--text);width:38px;height:38px;border-radius:9px;align-items:center;justify-content:center;cursor:pointer;}
@media(max-width:900px){.menu-toggle{display:flex;}}
.top-actions{display:flex;gap:10px;flex:none;}

/* ============ COMPONENTS ============ */
.btn{
  font-family:var(--font-display);font-weight:700;font-size:13px;
  padding:9px 15px;border-radius:9px;border:1px solid var(--border);
  background:var(--elevated);color:var(--text);cursor:pointer;
  display:inline-flex;align-items:center;gap:7px;white-space:nowrap;
  transition:transform .1s, border-color .15s, background .15s;
}
.btn:hover{border-color:var(--teal-dim);transform:translateY(-1px);}
.btn.primary{background:linear-gradient(135deg, var(--teal), #22b8a3);color:#06231f;border:none;}
.btn.primary:hover{filter:brightness(1.06);}
.btn.ghost{background:transparent;}
.btn.danger{color:var(--red);}
.btn.sm{padding:6px 10px;font-size:12px;border-radius:7px;}
.btn.auth{background:rgba(94,170,255,.12);border-color:rgba(94,170,255,.25);color:var(--blue);}
.btn.auth:hover{border-color:var(--blue);}

.grid{display:grid;gap:16px;}
.grid.cols-4{grid-template-columns:repeat(4,1fr);}
.grid.cols-3{grid-template-columns:repeat(3,1fr);}
.grid.cols-2{grid-template-columns:repeat(2,1fr);}
@media(max-width:1100px){.grid.cols-4{grid-template-columns:repeat(2,1fr);}.grid.cols-3{grid-template-columns:repeat(2,1fr);}}
@media(max-width:640px){.grid.cols-4,.grid.cols-3,.grid.cols-2{grid-template-columns:1fr;}}

.card{
  background:linear-gradient(180deg, var(--panel-2), var(--panel));
  border:1px solid var(--border-soft);border-radius:var(--radius-lg);
  padding:18px;position:relative;overflow:hidden;
}
.card.railed{border-left:3px solid var(--rail,var(--teal));}

.kpi .kpi-top{display:flex;align-items:center;justify-content:space-between;color:var(--text-dim);font-size:12px;font-weight:600;}
.kpi .kpi-num{font-family:var(--font-mono);font-size:30px;font-weight:600;margin-top:10px;color:var(--text);}
.kpi .kpi-foot{margin-top:6px;font-size:11.5px;color:var(--text-faint);}
.kpi .kpi-foot.up{color:var(--green);}
.kpi .kpi-foot.warn{color:var(--amber);}
.kpi .kpi-foot.bad{color:var(--red);}

.section-title{display:flex;align-items:center;justify-content:space-between;margin:30px 0 14px;gap:10px;flex-wrap:wrap;}
.section-title h2{font-size:15px;margin:0;letter-spacing:.01em;}
.section-title .hint{color:var(--text-faint);font-size:11.5px;font-family:var(--font-mono);}

.dtag{
  display:inline-flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:10.5px;
  padding:3px 8px 3px 7px;border-radius:20px;background:var(--elevated);border:1px solid var(--border);
  color:var(--text-dim);white-space:nowrap;
}
.dtag .dot{width:6px;height:6px;border-radius:50%;background:var(--dc,var(--teal));flex:none;}

.dh-card{display:flex;flex-direction:column;gap:12px;}
.dh-head{display:flex;align-items:center;gap:12px;}
.dh-icon{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-weight:700;font-size:15px;flex:none;color:#06131a;}
.dh-name{font-weight:700;font-size:15px;}
.dh-desc{color:var(--text-dim);font-size:12.5px;line-height:1.5;}
.dh-url{font-family:var(--font-mono);font-size:10.5px;color:var(--text-faint);word-break:break-all;}
.dh-stats{display:flex;gap:14px;margin-top:2px;}
.dh-stat{font-family:var(--font-mono);}
.dh-stat b{display:block;font-size:18px;color:var(--text);}
.dh-stat span{font-size:10px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;}
.dh-actions{display:flex;gap:8px;margin-top:auto;padding-top:6px;}

.table-wrap{background:var(--panel-2);border:1px solid var(--border-soft);border-radius:var(--radius-lg);overflow:hidden;}
table{width:100%;border-collapse:collapse;font-size:13px;}
thead th{
  text-align:left;font-family:var(--font-mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;
  color:var(--text-faint);padding:11px 14px;border-bottom:1px solid var(--border-soft);background:var(--panel);white-space:nowrap;
}
tbody td{padding:11px 14px;border-bottom:1px solid var(--border-soft);vertical-align:middle;}
tbody tr:last-child td{border-bottom:none;}
tbody tr:hover{background:rgba(255,255,255,.015);}
.cell-main{font-weight:600;}
.cell-sub{color:var(--text-faint);font-size:11.5px;margin-top:2px;}
.table-empty{padding:34px 20px;text-align:center;color:var(--text-faint);font-size:13px;}
.table-toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;padding:12px 14px;border-bottom:1px solid var(--border-soft);background:var(--panel);}
.table-scroll{overflow-x:auto;}

input,select,textarea{
  font-family:var(--font-display);font-size:13px;color:var(--text);
  background:var(--elevated);border:1px solid var(--border);border-radius:8px;
  padding:8px 11px;width:100%;
}
textarea{resize:vertical;min-height:70px;}
input:focus,select:focus,textarea:focus{border-color:var(--teal-dim);}
label{display:block;font-size:11.5px;color:var(--text-dim);margin-bottom:5px;font-weight:600;}
.field{margin-bottom:13px;}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
@media(max-width:560px){.field-row{grid-template-columns:1fr;}}

.badge{font-family:var(--font-mono);font-size:10.5px;padding:3px 9px;border-radius:20px;font-weight:600;display:inline-block;white-space:nowrap;}
.badge.b-new{background:rgba(94,170,255,.15);color:var(--blue);}
.badge.b-progress{background:rgba(242,165,65,.15);color:var(--amber);}
.badge.b-done{background:rgba(74,222,128,.15);color:var(--green);}
.badge.b-lost{background:rgba(239,90,111,.15);color:var(--red);}
.badge.b-neutral{background:var(--elevated);color:var(--text-dim);}

.sev-critical{color:var(--red);font-weight:700;}
.sev-high{color:var(--amber);font-weight:700;}
.sev-medium{color:var(--blue);}
.sev-low{color:var(--text-dim);}

.stars{color:var(--amber);font-family:var(--font-mono);letter-spacing:1px;}

.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px;}
.tab-btn{
  font-family:var(--font-mono);font-size:11.5px;font-weight:600;padding:7px 13px;border-radius:8px;
  background:var(--panel-2);border:1px solid var(--border-soft);color:var(--text-dim);cursor:pointer;
}
.tab-btn.active{background:rgba(45,212,191,.1);border-color:rgba(45,212,191,.3);color:var(--teal);}

/* modal */
.overlay{position:fixed;inset:0;background:rgba(6,9,14,.72);backdrop-filter:blur(3px);display:flex;align-items:flex-start;justify-content:center;padding:5vh 16px;z-index:100;overflow-y:auto;}
.overlay.hidden{display:none;}
.modal{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius-lg);width:100%;max-width:560px;padding:24px;box-shadow:0 30px 80px rgba(0,0,0,.5);}
.modal h3{margin:0 0 4px;font-size:16px;}
.modal .modal-sub{color:var(--text-faint);font-size:12px;margin-bottom:18px;}
.modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px;}

.empty-state{text-align:center;padding:50px 20px;color:var(--text-faint);}
.empty-state .icon{font-size:26px;margin-bottom:10px;opacity:.6;}
.empty-state .msg{font-size:13.5px;color:var(--text-dim);margin-bottom:14px;}

.banner{
  display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:11px;
  background:rgba(242,165,41,.08);border:1px solid rgba(242,165,41,.25);color:#f2c383;font-size:12.5px;margin-bottom:22px;
}
.banner.info{background:rgba(94,170,255,.08);border-color:rgba(94,170,255,.25);color:#a9cdff;}
.banner.success{background:rgba(74,222,128,.08);border-color:rgba(74,222,128,.25);color:#80f0a0;}
.banner b{font-weight:700;}
.banner .btn{flex:none;}

.rail-dot{width:8px;height:8px;border-radius:50%;flex:none;background:var(--rc,var(--teal));}

.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;}
.cal-dow{font-family:var(--font-mono);font-size:10px;color:var(--text-faint);text-align:center;padding-bottom:4px;text-transform:uppercase;letter-spacing:.08em;}
.cal-cell{min-height:74px;border:1px solid var(--border-soft);border-radius:9px;padding:6px;background:var(--panel-2);cursor:pointer;}
.cal-cell.today{border-color:var(--teal-dim);}
.cal-cell.faded{opacity:.35;}
.cal-cell .d{font-family:var(--font-mono);font-size:11px;color:var(--text-dim);}
.cal-cell .items{margin-top:4px;display:flex;flex-direction:column;gap:2px;}
.cal-chip{font-size:9.5px;background:var(--elevated);border-radius:5px;padding:1px 5px;color:var(--text-dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.cal-more{font-size:9.5px;color:var(--text-faint);}

.freelancer-row{display:flex;align-items:center;gap:12px;}
.avatar{width:32px;height:32px;border-radius:50%;background:var(--elevated);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:11px;font-weight:700;color:var(--text-dim);flex:none;}

.icon-btn{background:transparent;border:1px solid transparent;color:var(--text-faint);width:28px;height:28px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;}
.icon-btn:hover{background:var(--elevated);color:var(--text);border-color:var(--border);}
.row-actions{display:flex;gap:4px;justify-content:flex-end;}

.chk{display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--text-dim);}
.chk input{width:auto;}

.footer-note{margin-top:44px;padding-top:18px;border-top:1px solid var(--border-soft);color:var(--text-faint);font-size:11.5px;font-family:var(--font-mono);display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;}

.settings-block{background:var(--panel-2);border:1px solid var(--border-soft);border-radius:var(--radius-lg);padding:20px;margin-bottom:18px;}
.settings-block h3{margin:0 0 4px;font-size:14px;}
.settings-block .desc{color:var(--text-faint);font-size:12px;margin-bottom:16px;max-width:70ch;line-height:1.6;}
code.inline{background:var(--elevated);border:1px solid var(--border);padding:1px 6px;border-radius:5px;font-family:var(--font-mono);font-size:11.5px;}
.auth-status{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.auth-status .pill{background:var(--elevated);border:1px solid var(--border);border-radius:20px;padding:2px 10px;font-size:11px;color:var(--text-dim);}
.auth-status .pill.admin{color:var(--teal);border-color:rgba(45,212,191,.3);}

/* ---------- CALENDAR GRID ---------- */
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;}
.cal-dow{font-family:var(--font-mono);font-size:10px;color:var(--text-faint);text-align:center;padding-bottom:4px;text-transform:uppercase;letter-spacing:.08em;}
.cal-cell{min-height:70px;border:1px solid var(--border-soft);border-radius:8px;padding:5px;background:var(--panel-2);cursor:pointer;}
.cal-cell.today{border-color:var(--teal-dim);}
.cal-cell.faded{opacity:.35;}
.cal-cell .d{font-family:var(--font-mono);font-size:11px;color:var(--text-dim);}
.cal-cell .items{margin-top:3px;display:flex;flex-direction:column;gap:2px;}
.cal-chip{font-size:9px;background:var(--elevated);border-radius:4px;padding:1px 4px;color:var(--text-dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.cal-more{font-size:9px;color:var(--text-faint);}
</style>
</head>
<body>

<div class="app">
  <!-- ============ SIDEBAR ============ -->
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-mark">MG</div>
      <div class="brand-text">
        <div class="g">Mbulaheni Group</div>
        <div class="s">Central OS</div>
      </div>
    </div>

    <nav class="nav">
      <div class="nav-label">Overview</div>
      <div class="nav-item active" data-tab="dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
        <span>Dashboard</span>
      </div>
      <div class="nav-item" data-tab="hub">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="5" r="2.4"/><circle cx="5" cy="19" r="2.4"/><circle cx="19" cy="19" r="2.4"/><path d="M12 7.4V13m0 0-5.6 4.2M12 13l5.6 4.2"/></svg>
        <span>Division Hub</span>
      </div>

      <div class="nav-label">Operations</div>
      <div class="nav-item" data-tab="crm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19V6a2 2 0 0 1 2-2h9l5 5v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M14 4v4a1 1 0 0 0 1 1h4"/><path d="M8 13h8M8 17h5"/></svg>
        <span>CRM</span><span class="nav-badge" id="crmOpenBadge">0</span>
      </div>
      <div class="nav-item" data-tab="staff">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3.2"/><path d="M2.8 19c.6-3.4 3-5.4 6.2-5.4S15.6 15.6 16.2 19"/><circle cx="18" cy="8.5" r="2.4"/><path d="M15.6 13.9c2.6.2 4.4 2 4.9 4.6"/></svg>
        <span>Staff / HR</span>
      </div>
      <div class="nav-item" data-tab="freelancers">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="5" r="2.4"/><path d="M2.8 19c.6-3.4 3-5.4 6.2-5.4S15.6 15.6 16.2 19"/><circle cx="18" cy="8.5" r="2.4"/></svg>
        <span>Freelancers</span>
      </div>
      <div class="nav-item" data-tab="calendar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
        <span>Unified Calendar</span>
      </div>

      <div class="nav-label">System</div>
